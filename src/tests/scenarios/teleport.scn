# Teleport the wizard (cells, world units, with a height) and check where it is.
name teleport
level 1

1 where me
1 assert_pos me 122 137        # the start position of level 1

teleport 60 70                 # cell 60,70, at the ground height + 0x100
wait 1
assert_pos me 60 70 0          # exactly the centre of the cell
where me

teleport 3200w 4000w 2000      # world units, z = 2000
wait 1
assert_pos me 3200w 4000w 0
where me

# the camera log follows (player_log_position): flying on from there works
10 teleport 200 30
11 assert_pos me 200 30 1
40 assert_pos me 200 30 1      # nobody steers: it stays
40 assert_alive me
